# ====================================================================
# DigiHall AI - Git Ignore Rules
# ====================================================================

# --------------------------------------------------------------------
# 1. Python & Backend Environment
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller / Testing / Coverage
*.manifest
*.spec
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --------------------------------------------------------------------
# 2. Node.js & Next.js Frontend
# --------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.turbo/
frontend/.turbo/

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js bundle analyzer / telemetry
.next/cache/
next-env.d.ts

# --------------------------------------------------------------------
# 3. Environment Variables & Credentials
# --------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Keep example env file if added
!.env.example

# --------------------------------------------------------------------
# 4. Runtime Attendance Snapshots & Dynamic Captured Media
# (Prevents personal live photos/signatures from being committed)
# --------------------------------------------------------------------
data/attendance/*
!data/attendance/.gitkeep
data/faces/*
!data/faces/.gitkeep

# --------------------------------------------------------------------
# 5. Operating System & IDE Files
# --------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# IDEs & Text Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Scratch & Temporary
scratch/
tmp/
temp/
*.log
